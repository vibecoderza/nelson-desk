# Names only. Alan sets the values in Vercel and in his own local env file.
# Values never go in this repo, a brief, a ticket or a chat.

# Hosts
DESK_HOST=desk.dearnelson.co.za
PORTAL_HOST=my.dearnelson.co.za

# Database (own Neon project). The Portal connects as a role that is a member of desk_portal.
DATABASE_URL=
DATABASE_URL_PORTAL=

# Clerk, two applications. The Desk application: sign-up restricted to an allow-list, second factor required.
CLERK_DESK_PUBLISHABLE_KEY=
CLERK_DESK_SECRET_KEY=
# The Portal application: Google and email link, Organisations on.
CLERK_PORTAL_PUBLISHABLE_KEY=
CLERK_PORTAL_SECRET_KEY=
# Needed because the secret key is chosen per request: openssl rand -hex 32
CLERK_ENCRYPTION_KEY=
# Comma-separated staff emails. The second lock behind Clerk's own allow-list.
DESK_STAFF_EMAILS=
# "off" skips the Desk's second factor, but only while DATABASE_URL and DATABASE_URL_PORTAL are both unset.
# Delete it once the Desk Clerk app has multi-factor.
DESK_SECOND_FACTOR=

# The seam with Nelson (brief 6.7). Set the same two values in both projects.
DESK_WEBHOOK_SECRET=
PORTAL_TOKEN_SIGNING_KEY=
NELSON_BASE_URL=
NELSON_API_KEY=
NELSON_STAFF_API_KEY=

# Vercel Cron
CRON_SECRET=
