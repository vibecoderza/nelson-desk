{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.dearnelson.co.za/v1/order-from-quote-request.json",
  "type": "object",
  "properties": {
    "quote_ref": {
      "$ref": "common.json#/$defs/quote_ref"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "price_version": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "product_code": {
            "$ref": "common.json#/$defs/product_code"
          },
          "colour": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "design": {
            "$ref": "common.json#/$defs/design_pin"
          },
          "unit_cents": {
            "$ref": "common.json#/$defs/cents"
          },
          "setup_cents": {
            "$ref": "common.json#/$defs/cents"
          }
        },
        "required": [
          "line_id",
          "product_code",
          "colour",
          "quantity",
          "design",
          "unit_cents",
          "setup_cents"
        ],
        "additionalProperties": false
      }
    },
    "contact": {
      "$ref": "common.json#/$defs/contact"
    },
    "ship_to": {
      "$ref": "common.json#/$defs/address"
    },
    "delivery": {
      "type": "object",
      "properties": {
        "service": {
          "enum": [
            "economy",
            "express"
          ]
        },
        "price_cents": {
          "$ref": "common.json#/$defs/cents"
        }
      },
      "required": [
        "service",
        "price_cents"
      ],
      "additionalProperties": false
    },
    "payment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "deposit",
            "full"
          ]
        },
        "amount_cents": {
          "$ref": "common.json#/$defs/cents"
        }
      },
      "required": [
        "kind",
        "amount_cents"
      ],
      "additionalProperties": false
    },
    "total_cents": {
      "$ref": "common.json#/$defs/cents"
    }
  },
  "required": [
    "quote_ref",
    "version",
    "price_version",
    "client_id",
    "lines",
    "contact",
    "ship_to",
    "delivery",
    "payment",
    "total_cents"
  ],
  "additionalProperties": false,
  "title": "POST /api/v1/orders/from-quote request"
}
