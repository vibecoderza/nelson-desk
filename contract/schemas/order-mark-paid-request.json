{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.dearnelson.co.za/v1/order-mark-paid-request.json",
  "type": "object",
  "properties": {
    "method": {
      "const": "eft"
    },
    "amount_cents": {
      "$ref": "common.json#/$defs/cents"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "received_on": {
      "type": "string",
      "format": "date"
    },
    "marked_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "method",
    "amount_cents",
    "reference",
    "received_on",
    "marked_by"
  ],
  "additionalProperties": false,
  "title": "POST /api/v1/orders/{ref}/mark-paid request"
}
